// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(65001)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_WINPOSKEEPER       ICON                    "WinPosKeeper.ico"
IDR_EMBEDDED_README     RCDATA                  "README.md"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_WINPOSKEEPER MENU
BEGIN
    POPUP "&WinPosKeeper"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Also restore positions when monitors &disconnect", IDM_RESTORE_ON_DISCONNECT, CHECKED
        MENUITEM "Start with &Windows",         IDM_AUTOSTART
        MENUITEM "&Persist Positions to Disk",  IDM_PERSIST_POSITIONS
        MENUITEM "Enable Event &Logging",       IDM_ENABLE_LOGGING, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "C&lear Log",                  IDM_CLEAR_LOG
        MENUITEM "Copy &All Log",               IDM_COPY_ALL_LOG
        MENUITEM SEPARATOR
        MENUITEM "&Hide Window",                IDM_HIDEWINDOW
        MENUITEM "E&xit",                       IDM_EXIT
    END
END

IDR_TRAYMENU MENU
BEGIN
    POPUP "WinPosKeeper"
    BEGIN
        MENUITEM "Show Window...",              IDM_SHOWWINDOW
        MENUITEM "&About ...",                  IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "Also restore positions when monitors &disconnect", IDM_RESTORE_ON_DISCONNECT, CHECKED
        MENUITEM "Start with &Windows",         IDM_AUTOSTART
        MENUITEM "&Persist Positions to Disk",  IDM_PERSIST_POSITIONS
        MENUITEM "Enable Event &Logging",       IDM_ENABLE_LOGGING, CHECKED
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_WINPOSKEEPER ACCELERATORS
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About WinPosKeeper"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_WINPOSKEEPER,IDC_STATIC,14,14,20,20
    LTEXT           "WinPosKeeper, Version 2.0, 2026",IDC_STATIC,42,14,172,8,SS_NOPREFIX
    LTEXT           "Based on the original MonitorKeeper by Garr Godfrey",IDC_STATIC,42,26,172,16
    DEFPUSHBUTTON   "OK",IDOK,178,41,50,14,WS_GROUP
END


